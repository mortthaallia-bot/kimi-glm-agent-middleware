# Kimi Agent Middleware Configuration
# ========================================

# Kimi Auth Token (JWT Refresh Token or Bearer Token from kimi.ai/kimi.com)
STRAICO_API_KEY=your_kimi_jwt_token_here

# Base URL for Kimi Web/API
KIMI_BASE_URL=https://www.kimi.com

# Ports Configuration
UPSTREAM_PORT=8000
PROXY_PORT=8001

# Streaming Mode: 'none' or 'smart'
STREAM_MODE=none

# Provider Type: 'straico' (Kimi Upstream Connect RPC bridge)
PROVIDER_TYPE=straico

# NVIDIA NIM API Key (Free API for Vision Analyzer 120B model)
# Get a free key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
