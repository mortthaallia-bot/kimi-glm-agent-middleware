# GLM Agent Middleware Configuration (DOAI-Proxy)
# ===============================================

# GLM API Key (from Zhipu / BigModel / Z.ai)
GLM_API_KEY=your_glm_jwt_or_api_key_here

# Proxy Port (Hermes / OpenAI client connects here)
PROXY_PORT=3000

# Streaming Mode: 'none' or 'smart'
STREAM_MODE=none

# Provider Type: 'glm'
PROVIDER_TYPE=glm

# Upstream GLM Base URL (defaults to BigModel or Z.ai)
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
